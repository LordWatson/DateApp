# Production settings for Date Night. Copy to .env on the server and fill in.
# See docs/DEPLOY.md for the full checklist.

APP_NAME="Date Night"
APP_ENV=production
APP_KEY=                      # php artisan key:generate ; back this up
APP_DEBUG=false
APP_URL=https://your-domain.example   # links in emails are built from this

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Behind a load balancer or proxy: its address(es), comma separated, or * when
# only the proxy can reach the app. Without it rate limits and https links break.
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Migrations have only been run on SQLite so far; try them on a copy first.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=datenight
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database     # worker must use --queue=default,notifications,emails,analytics,ai,exports

# Mail. The default mailer is "log", which sends nothing.
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=hello@your-domain.example   # the domain must be verified with the mail provider
MAIL_FROM_NAME="${APP_NAME}"

# Uploads (moment photos, admin media). "local" is the private disk in storage/app/private.
# On hosts that wipe the disk on deploy use "s3" (needs league/flysystem-aws-s3-v3 and the AWS_* keys).
FILESYSTEM_DISK=local
UPLOADS_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI. Without a key the app uses its built-in plans. AI_PROVIDER=null switches AI off.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash

# Server-side rendering needs its own process (see docs/DEPLOY.md); leave off otherwise.
INERTIA_SSR_ENABLED=false

# When set, GET /health needs "Authorization: Bearer <token>". /up is always open.
HEALTH_TOKEN=

# Shown in the privacy policy and terms.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Push notifications: path to the Firebase service account JSON (blank = no push)
FIREBASE_CREDENTIALS=
